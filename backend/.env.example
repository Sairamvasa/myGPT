# Required in production. Use a long random value.
JWT_SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=development

# Ollama (local development)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1000
OLLAMA_KEEP_ALIVE=10m

# Upload and RAG storage
MAX_UPLOAD_BYTES=26214400
MAX_TOTAL_UPLOAD_BYTES=104857600
MAX_UPLOAD_FILES=20
RAG_STORAGE_DIR=./rag_indexes

# Comma-separated frontend origins. Do not use a wildcard in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional desktop app allow-list. Leave empty to disable app launching.
MYGPT_ALLOWED_APPS=
