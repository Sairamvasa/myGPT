# Required in production. Use a long random value.
JWT_SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=development

# Model Router Configuration
# AI_PROVIDER: Primary provider when MODEL_ROUTER_PROVIDER is not set
# MODEL_ROUTER_PROVIDER: Explicit provider for model routing (ollama, gemini, omniroute)
AI_PROVIDER=ollama
MODEL_ROUTER_PROVIDER=

# OmniRoute Configuration (centralized model gateway)
# Enable by setting OMNIROUTE_BASE_URL and OMNIROUTE_API_KEY
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto/best-chat
OMNIROUTE_TIMEOUT=60

# Ollama (local development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.2:1b
OLLAMA_CODE_MODEL=codellama:7b
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1000
OLLAMA_KEEP_ALIVE=10m

# Gemini Configuration
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-1.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp-image-generation
GEMINI_MAX_RETRIES=2
GEMINI_BASE_DELAY=1.0
GEMINI_MAX_DELAY=8.0

# Upload and RAG storage
MAX_UPLOAD_BYTES=26214400
MAX_TOTAL_UPLOAD_BYTES=104857600
MAX_UPLOAD_FILES=20
RAG_STORAGE_DIR=./rag_indexes
RAG_RELEVANCE_THRESHOLD=1.70

# Comma-separated frontend origins. Do not use a wildcard in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional desktop app allow-list. Leave empty to disable app launching.
MYGPT_ALLOWED_APPS=

# Performance telemetry (disabled by default)
PERF_LOGGING=false
